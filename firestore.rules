rules_version = '2';
// ============================================================
//  Reglas de Firestore - Menu YAMA (proyecto menu-proesa-yama)
//  Mismo esquema que LANS:
//  - Todo requiere token (Firebase Auth anonimo). Sin token = nada.
//  - PINs en config/secrets, ilegibles desde el cliente:
//      adminPin -> nivel "admin": menu, pedidos, cortesias, historial, buzon
//      superPin -> nivel "super": todo lo de admin + catalogo de empleados
//  - El admin "inicia sesion" creando admin_sessions/{uid} con el PIN;
//    las reglas comparan el PIN contra config/secrets y guardan el nivel. Expira a las 12 h.
//  - Empleados: entran desde el Gestor de Personal (Cloud Function ssoCallback). Su token trae
//    el claim numEmp (normalizado: mayusculas, sin ceros a la izquierda = id de orders/{id}).
//    Cada quien solo lee, crea, modifica y borra SU pedido. El anonimo (sin numEmp) ya no
//    puede pedir; solo sirve para ver el menu y para el acceso de admin con PIN.
// ============================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function secrets() {
      return get(/databases/$(db)/documents/config/secrets).data;
    }

    function sessionPath() {
      return /databases/$(db)/documents/admin_sessions/$(request.auth.uid);
    }

    function hasSession() {
      return signedIn()
        && exists(sessionPath())
        && get(sessionPath()).data.createdAt > request.time - duration.value(12, 'h');
    }

    function level() {
      return get(sessionPath()).data.level;
    }

    function isAdmin() {
      return hasSession() && level() in ['admin', 'super'];
    }

    function isSuper() {
      return hasSession() && level() == 'super';
    }

    function numEmp() {
      return signedIn() && request.auth.token.get('numEmp', null) is string
        ? request.auth.token.numEmp : null;
    }

    function normEmp(s) {
      return s.upper().replace('^0+', '');
    }

    // El pedido orders/{id} es del empleado si el id es su numEmp y el numEmpleado
    // guardado (normalizado) tambien. d = request.resource.data o resource.data.
    function esMiPedido(id, d) {
      return numEmp() != null && numEmp() == id
        && d.numEmpleado is string && normEmp(d.numEmpleado) == id;
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'numEmpleado', 'fecha', 'total', 'detalle', 'opciones'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.numEmpleado is string && d.numEmpleado.size() > 0 && d.numEmpleado.size() <= 20
        && d.fecha is string && d.fecha.size() <= 40
        && d.total is int && d.total >= 0 && d.total <= 50
        && d.detalle is map && d.detalle.size() <= 7
        && (!('opciones' in d) || (d.opciones is map && d.opciones.size() <= 7));
    }

    function validComentario() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'texto', 'foto', 'fecha', 'leido'])
        && d.nombre is string && d.nombre.size() <= 120
        && d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 2000
        && d.fecha is string && d.fecha.size() <= 40
        && (!('leido' in d) || d.leido == false)
        && (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 900000));
    }

    // --- Secretos: nadie los lee ni escribe desde el cliente ---
    match /config/secrets {
      allow read, write: if false;
    }

    // --- Configuracion ---
    match /config/{doc} {
      allow read: if (signedIn() && doc in ['menu', 'catalogo'])
        || (isAdmin() && doc in ['cortesias', 'comentarios']);
      allow write: if (doc in ['menu', 'cortesias', 'comentarios'] && isAdmin())
        || (doc == 'catalogo' && isSuper());
    }

    // --- Historial por quincena (los empleados ven su acumulado) ---
    match /historial/{quincena} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Sesiones de admin (una por navegador/uid) ---
    match /admin_sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'level', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.level == 'super' && request.resource.data.pin == secrets().superPin)
          || (request.resource.data.level == 'admin' && request.resource.data.pin == secrets().adminPin)
        );
    }

    // --- Pedidos: un documento por numero de empleado ---
    match /orders/{id} {
      allow get: if isAdmin() || (numEmp() != null && numEmp() == id);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (validOrder() && esMiPedido(id, request.resource.data));
      allow delete: if isAdmin() || esMiPedido(id, resource.data);
    }

    // --- Buzon: cualquiera crea; admin lee, marca leido y borra ---
    match /comentarios/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && validComentario();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
    }

    // Todo lo demas: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
